# Cloudflare Workers AI credentials for private, opt-in agentic chunking.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Cohere Embed v4 and Rerank v4 credentials. Keep the real value in .env only.
COHERE_API_KEY=

# Server-side API and Neo4j runtime configuration.
LUNARBIT_PRIVATE_API_TOKEN=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
