# Provider and authentication secrets. Never commit real values.
COHERE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
LUNARBIT_PRIVATE_API_TOKEN=

# Neo4j connection settings. Use neo4j+s:// for production Aura.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Browser/API deployment configuration.
LUNARBIT_PUBLIC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LUNARBIT_SESSION_DB=/var/lib/lunarbit/conversations.sqlite3
